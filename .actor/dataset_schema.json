{
	"actorSpecification": 1,
	"fields": {
		"type": "object",
		"properties": {
			"ico": { "type": "string" },
			"country": { "type": "string", "enum": ["cz", "sk"] },
			"name": { "type": ["string", "null"] },
			"legalForm": { "type": ["string", "null"] },
			"establishedAt": { "type": ["string", "null"] },
			"dissolvedAt": { "type": ["string", "null"] },
			"dic": { "type": ["string", "null"] },
			"icDph": { "type": ["string", "null"] },
			"address": {
				"type": ["object", "null"],
				"properties": {
					"full": { "type": ["string", "null"] },
					"street": { "type": ["string", "null"] },
					"zip": { "type": ["string", "null"] },
					"city": { "type": ["string", "null"] }
				}
			},
			"classification": {
				"type": ["object", "null"],
				"description": "Klasifikační údaje. CZ: nace = primární NACE z ARES (CZ-NACE 2008), naceCodes = pole všech přidělených oborů (CZ specialita), region/district = kraj/okres, spisovaZnacka z MSP. SK: nace = NACE z finstat (typicky 4-místný), spisovaZnacka z RPO. employeeCategory bývá vyplněn jen pro některé velké SK firmy.",
				"properties": {
					"nace": { "type": ["string", "null"] },
					"naceDescription": { "type": ["string", "null"] },
					"naceCodes": {
						"type": ["array", "null"],
						"items": { "type": "string" }
					},
					"employeeCategory": { "type": ["string", "null"] },
					"region": { "type": ["string", "null"] },
					"district": { "type": ["string", "null"] },
					"spisovaZnacka": { "type": ["string", "null"] }
				}
			},
			"financials": {
				"type": ["object", "null"],
				"description": "Finanční ukazatele za poslední rok. SK firmy: revenue/profit/assets/equity z finstat (typicky a.s./s.r.o. se zveřejněnou závěrkou). CZ firmy: jen registeredCapital (základní kapitál) z MSP rejstříku. Subjekty bez finanční povinnosti (SVJ, spolky, malé s.r.o., státní org) mají null.",
				"properties": {
					"year": { "type": ["integer", "null"] },
					"revenue": { "type": ["number", "null"] },
					"profit": { "type": ["number", "null"] },
					"assets": { "type": ["number", "null"] },
					"equity": { "type": ["number", "null"] },
					"registeredCapital": { "type": ["string", "null"] },
					"currency": { "type": ["string", "null"] }
				}
			},
			"financialHistory": {
				"type": ["object", "null"],
				"description": "Až 5letá historie finančních ukazatelů. JEN PRO SK subjekty se zveřejněnou účetní závěrkou (typicky a.s. a větší s.r.o.). CZ ekvivalent zdarma neexistuje. Každé pole je pole bodů [{year, value}] seřazené chronologicky.",
				"properties": {
					"revenue": {
						"type": ["array", "null"],
						"items": { "type": "object" }
					},
					"profit": {
						"type": ["array", "null"],
						"items": { "type": "object" }
					},
					"assets": {
						"type": ["array", "null"],
						"items": { "type": "object" }
					},
					"equity": {
						"type": ["array", "null"],
						"items": { "type": "object" }
					},
					"totalRevenue": {
						"type": ["array", "null"],
						"items": { "type": "object" }
					}
				}
			},
			"businessActivities": {
				"type": ["object", "null"],
				"description": "Předmět podnikání / činnosti. CZ: živnostenská licence (license) + obory činnosti (activities[]). SK: jen activities[] pro subjekty s aktivními předměty podnikania. Nadace, spolky, SVJ a státní org nemívají vyplněno.",
				"properties": {
					"license": { "type": ["string", "null"] },
					"activities": {
						"type": ["array", "null"],
						"items": { "type": "string" }
					}
				}
			},
			"directors": {
				"type": ["array", "null"],
				"description": "Statutární orgán. POUZE CZ z MSP rejstříku — finstat.sk pro SK skrývá za Premium. Role se liší podle typu: Jednatel (s.r.o.), Předseda/Člen představenstva (a.s.), Předseda/Člen výboru (SVJ, spolky, družstva), Předseda/Člen správní rady (nadace, ústavy), Likvidátor, Prokurista. Státní organizace, ministerstva a veřejné VŠ statutáře z ARES nemají.",
				"items": {
					"type": "object",
					"properties": {
						"role": { "type": "string" },
						"name": { "type": ["string", "null"] },
						"birthDate": { "type": ["string", "null"] },
						"address": { "type": ["string", "null"] },
						"sinceDate": { "type": ["string", "null"] }
					}
				}
			},
			"partners": {
				"type": ["array", "null"],
				"description": "Společníci/vlastníci a jejich podíly. POUZE CZ s.r.o. (a vybrané právní formy s viditelnou vlastnickou strukturou). Akcionáři velkých CZ a.s. zde nejsou — jsou neveřejní v CDCP. SK subjekty zde nemají data (finstat skrývá za Premium). Každý společník má pole shares[] s detaily podílu.",
				"items": {
					"type": "object",
					"properties": {
						"name": { "type": ["string", "null"] },
						"ico": { "type": ["string", "null"] },
						"isPerson": { "type": "boolean" },
						"address": { "type": ["string", "null"] },
						"shares": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"investment": { "type": ["number", "null"] },
									"paidPercent": { "type": ["number", "null"] },
									"fraction": { "type": ["string", "null"] },
									"type": { "type": ["string", "null"] }
								}
							}
						}
					}
				}
			},
			"warnings": {
				"type": ["object", "null"],
				"description": "Stavové vlajky pro KYC/due-diligence. CZ: hasInsolvency je odvozeno z ARES (stavZdrojeIr). SK: hasInsolvency/hasDebts/hasTemporaryProtection se čte z finstat.sk veřejných flagů. Pole je null jen pokud nelze zjistit ani z jednoho zdroje.",
				"properties": {
					"hasDebts": { "type": ["boolean", "null"] },
					"hasInsolvency": { "type": ["boolean", "null"] },
					"hasTemporaryProtection": { "type": ["boolean", "null"] }
				}
			},
			"vatStatus": {
				"type": ["object", "null"],
				"description": "Status DPH plátce. POUZE CZ z ARES (stavZdrojeDph). active=true znamená aktivní plátce DPH. SK ekvivalent (icDph) je v hlavním poli identifikace.",
				"properties": {
					"active": { "type": ["boolean", "null"] },
					"stateCode": { "type": ["string", "null"] }
				}
			},
			"registrace": {
				"type": ["object", "null"],
				"description": "Stavy v 6 CZ registrech z ARES — POUZE pro CZ subjekty. Hodnoty: AKTIVNI / NEEXISTUJICI / ZRUSENI. ROS=Registr osob, VR=Veřejný rejstřík, RES=Registr ekonomických subjektů, RZP=Registr živnost. podnikání, DPH=Plátci DPH, IR=Insolvenční rejstřík (zdroj insolvence flagu).",
				"properties": {
					"ros": { "type": ["string", "null"] },
					"vr": { "type": ["string", "null"] },
					"res": { "type": ["string", "null"] },
					"rzp": { "type": ["string", "null"] },
					"dph": { "type": ["string", "null"] },
					"ir": { "type": ["string", "null"] }
				}
			},
			"nameHistory": {
				"type": ["array", "null"],
				"description": "Historie obchodních jmen. POUZE SK z RPO data.gov.sk. Každý záznam má {name, validFrom, validTo}. validTo:null = aktuálně platné jméno. Užitečné pro audit fúzí, přejmenování a změn značky.",
				"items": {
					"type": "object",
					"properties": {
						"name": { "type": ["string", "null"] },
						"validFrom": { "type": ["string", "null"] },
						"validTo": { "type": ["string", "null"] }
					}
				}
			},
			"registrationOffice": {
				"type": ["string", "null"],
				"description": "Rejstříkový soud / úřad evidence. POUZE SK z RPO. Pro CZ je analog v classification.spisovaZnacka."
			},
			"dataFreshness": {
				"type": ["object", "null"],
				"description": "Audit čerstvosti dat. aresUpdatedAt = poslední synchronizace ARES (CZ, typicky denní). rpoUpdatedAt = poslední změna v RPO data.gov.sk (SK, jen při faktické změně subjektu — může být i staré měsíce/roky pro stabilní firmy). scrapedAt = čas tohoto runu actoru.",
				"properties": {
					"aresUpdatedAt": { "type": ["string", "null"] },
					"rpoUpdatedAt": { "type": ["string", "null"] },
					"scrapedAt": { "type": ["string", "null"] }
				}
			},
			"sourceUrl": { "type": "string" },
			"scrapedAt": { "type": "string" }
		},
		"required": ["ico", "country", "sourceUrl", "scrapedAt"]
	},
	"views": {
		"overview": {
			"title": "Přehled",
			"description": "Základní pohled — identifikace, adresa, klasifikace, poslední finanční rok, varování.",
