{
	"actorSpecification": 1,
	"fields": {
		"type": "object",
		"properties": {
			"ico": { "type": "string" },
			"country": { "type": "string", "enum": ["cz", "sk"] },
			"name": { "type": ["string", "null"] },
			"legalForm": { "type": ["string", "null"] },
			"establishedAt": { "type": ["string", "null"] },
			"dissolvedAt": { "type": ["string", "null"] },
			"dic": { "type": ["string", "null"] },
			"icDph": { "type": ["string", "null"] },
			"address": {
				"type": ["object", "null"],
				"properties": {
					"full": { "type": ["string", "null"] },
					"street": { "type": ["string", "null"] },
					"zip": { "type": ["string", "null"] },
					"city": { "type": ["string", "null"] }
				}
			},
			"classification": {
				"type": ["object", "null"],
				"description": "Classification of the subject. nace is the primary NACE code, naceDescription its human-readable label, naceCodes lists all registered codes when available. region and district describe the seat. spisovaZnacka is the file number in the registry. employeeCategory is populated only for larger companies that report it.",
				"properties": {
					"nace": { "type": ["string", "null"] },
					"naceDescription": { "type": ["string", "null"] },
					"naceCodes": {
						"type": ["array", "null"],
						"items": { "type": "string" }
					},
					"employeeCategory": { "type": ["string", "null"] },
					"region": { "type": ["string", "null"] },
					"district": { "type": ["string", "null"] },
					"spisovaZnacka": { "type": ["string", "null"] }
				}
			},
			"financials": {
				"type": ["object", "null"],
				"description": "Latest-year financial figures. SK companies typically return revenue, profit, assets, equity and currency. CZ companies typically return registered capital. Subjects with no disclosure obligation return null.",
				"properties": {
					"year": { "type": ["integer", "null"] },
					"revenue": { "type": ["number", "null"] },
					"profit": { "type": ["number", "null"] },
					"assets": { "type": ["number", "null"] },
					"equity": { "type": ["number", "null"] },
					"registeredCapital": { "type": ["string", "null"] },
					"currency": { "type": ["string", "null"] }
				}
			},
			"financialHistory": {
				"type": ["object", "null"],
				"description": "Up to 5 years of financial history. Returned for SK companies that publish annual statements (typically a.s. and larger s.r.o.). Each metric is an array of { year, value } points in chronological order.",
				"properties": {
					"revenue": {
						"type": ["array", "null"],
						"items": { "type": "object" }
					},
					"profit": {
						"type": ["array", "null"],
						"items": { "type": "object" }
					},
					"assets": {
						"type": ["array", "null"],
						"items": { "type": "object" }
					},
					"equity": {
						"type": ["array", "null"],
						"items": { "type": "object" }
					},
					"totalRevenue": {
						"type": ["array", "null"],
						"items": { "type": "object" }
					}
				}
			},
			"businessActivities": {
				"type": ["object", "null"],
				"description": "Business activities / scope of operation. CZ companies typically return a trade licence (license) plus a list of registered activities. SK companies typically return the activities only. Foundations, associations, HOAs and public-sector subjects are typically empty.",
				"properties": {
					"license": { "type": ["string", "null"] },
					"activities": {
						"type": ["array", "null"],
						"items": { "type": "string" }
					}
				}
			},
			"directors": {
				"type": ["array", "null"],
				"description": "Statutory body. Returned for CZ companies. Roles vary by entity type: Jednatel (s.r.o.), Předseda/Člen představenstva (a.s.), Předseda/Člen výboru (SVJ, spolek, družstvo), Předseda/Člen správní rady (nadace, ústav), Likvidátor, Prokurista.",
				"items": {
					"type": "object",
					"properties": {
						"role": { "type": "string" },
						"name": { "type": ["string", "null"] },
						"birthDate": { "type": ["string", "null"] },
						"address": { "type": ["string", "null"] },
						"sinceDate": { "type": ["string", "null"] }
					}
				}
			},
			"partners": {
				"type": ["array", "null"],
				"description": "Shareholders / members and their stakes. Returned for CZ entities whose ownership is publicly listed (typically s.r.o. and other legal forms with a public ownership structure). Each partner has a shares[] array with stake details.",
				"items": {
					"type": "object",
					"properties": {
						"name": { "type": ["string", "null"] },
						"ico": { "type": ["string", "null"] },
						"isPerson": { "type": "boolean" },
						"address": { "type": ["string", "null"] },
						"shares": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"investment": { "type": ["number", "null"] },
									"paidPercent": { "type": ["number", "null"] },
									"fraction": { "type": ["string", "null"] },
									"type": { "type": ["string", "null"] }
								}
							}
						}
					}
				}
			},
			"warnings": {
				"type": ["object", "null"],
				"description": "Risk flags for KYC and due diligence. CZ companies return hasInsolvency. SK companies return hasInsolvency, hasDebts and hasTemporaryProtection. The whole field is null only when no flag could be determined.",
				"properties": {
					"hasDebts": { "type": ["boolean", "null"] },
					"hasInsolvency": { "type": ["boolean", "null"] },
					"hasTemporaryProtection": { "type": ["boolean", "null"] }
				}
			},
			"vatStatus": {
				"type": ["object", "null"],
				"description": "VAT registration status. Returned for CZ companies. active=true means an active VAT payer. For SK companies the equivalent identifier (icDph) is in the top-level identification fields.",
				"properties": {
					"active": { "type": ["boolean", "null"] },
					"stateCode": { "type": ["string", "null"] }
				}
			},
			"registrace": {
				"type": ["object", "null"],
				"description": "Status across six CZ public registries. Returned for CZ companies. Values: AKTIVNI / NEEXISTUJICI / ZRUSENI. Keys: ros (registry of persons), vr (commercial registry), res (registry of economic subjects), rzp (trade licensing registry), dph (VAT payers), ir (insolvency registry, source of the hasInsolvency flag).",
				"properties": {
					"ros": { "type": ["string", "null"] },
					"vr": { "type": ["string", "null"] },
					"res": { "type": ["string", "null"] },
					"rzp": { "type": ["string", "null"] },
					"dph": { "type": ["string", "null"] },
					"ir": { "type": ["string", "null"] }
				}
			},
			"nameHistory": {
				"type": ["array", "null"],
				"description": "History of company names. Returned for SK companies. Each entry is { name, validFrom, validTo }; validTo:null marks the currently valid name. Useful for auditing mergers, renames and brand changes.",
				"items": {
					"type": "object",
					"properties": {
						"name": { "type": ["string", "null"] },
						"validFrom": { "type": ["string", "null"] },
						"validTo": { "type": ["string", "null"] }
					}
				}
			},
			"registrationOffice": {
				"type": ["string", "null"],
				"description": "Registry court or registration office. Returned for SK companies. The CZ analogue is in classification.spisovaZnacka."
			},
			"dataFreshness": {
				"type": ["object", "null"],
				"description": "Timestamps for data freshness audit. aresUpdatedAt is the last update timestamp of the CZ source record. rpoUpdatedAt is the last update timestamp of the SK source record. Both only change when the subject record itself changes, so values for stable companies can be months or years old. scrapedAt is when this Actor run fetched the data.",
				"properties": {
					"aresUpdatedAt": { "type": ["string", "null"] },
					"rpoUpdatedAt": { "type": ["string", "null"] },
					"scrapedAt": { "type": ["string", "null"] }
				}
			},
			"sourceUrl": { "type": "string" },
			"scrapedAt": { "type": "string" }
		},
		"required": ["ico", "country", "sourceUrl", "scrapedAt"]
	},
	"views": {
		"overview": {
			"title": "Overview",
			"description": "Default view — identification, address, classification, latest financial year and warning flags.",
			"transformation": {
				"fields": [
					"ico",
					"country",
					"name",
					"legalForm",
					"establishedAt",
					"address",
					"classification",
					"financials",
					"warnings",
					"sourceUrl",
					"scrapedAt"
				],
				"flatten": ["address", "classification", "financials", "warnings"]
			},
			"display": {
				"component": "table",
				"properties": {
					"ico": { "label": "IČO", "format": "text" },
					"country": { "label": "Country", "format": "text" },
					"name": { "label": "Name", "format": "text" },
					"legalForm": { "label": "Legal form", "format": "text" },
					"establishedAt": { "label": "Established", "format": "date" },
					"address.full": { "label": "Registered address", "format": "text" },
					"address.city": { "label": "City", "format": "text" },
					"classification.nace": { "label": "NACE", "format": "text" },
					"classification.naceDescription": {
						"label": "Industry",
						"format": "text"
					},
					"financials.revenue": { "label": "Revenue", "format": "number" },
					"financials.profit": { "label": "Profit", "format": "number" },
					"financials.year": { "label": "Year", "format": "number" },
					"warnings.hasInsolvency": {
						"label": "Insolvency",
						"format": "boolean"
					},
					"warnings.hasDebts": { "label": "Debts", "format": "boolean" },
					"vatStatus.active": { "label": "VAT payer", "format": "boolean" },
					"dataFreshness.aresUpdatedAt": {
						"label": "CZ updated",
						"format": "date"
					},
					"sourceUrl": { "label": "Source", "format": "link" },
					"scrapedAt": { "label": "Scraped", "format": "date" }
				}
			}
		},
		"finance": {
			"title": "Finance",
			"description": "Latest-year financial figures plus VAT status and freshness — for performance analysis and basic credit screening.",
			"transformation": {
				"fields": [
					"ico",
					"country",
					"name",
					"financials",
					"vatStatus",
					"dataFreshness"
				],
				"flatten": ["financials", "vatStatus", "dataFreshness"]
			},
			"display": {
				"component": "table",
				"properties": {
					"ico": { "label": "IČO", "format": "text" },
					"name": { "label": "Name", "format": "text" },
					"country": { "label": "Country", "format": "text" },
					"financials.year": { "label": "Year", "format": "number" },
					"financials.revenue": { "label": "Revenue", "format": "number" },
					"financials.profit": { "label": "Profit", "format": "number" },
					"financials.assets": { "label": "Assets", "format": "number" },
					"financials.equity": {
						"label": "Equity",
						"format": "number"
					},
					"financials.registeredCapital": {
						"label": "Registered capital",
						"format": "text"
					},
					"financials.currency": { "label": "Currency", "format": "text" },
					"vatStatus.active": { "label": "VAT payer", "format": "boolean" },
					"dataFreshness.aresUpdatedAt": {
						"label": "CZ updated",
						"format": "date"
					},
					"dataFreshness.rpoUpdatedAt": {
						"label": "SK updated",
						"format": "date"
					}
				}
			}
		},
		"people": {
			"title": "Directors & shareholders",
			"description": "Statutory body and ownership structure (returned for CZ companies).",
			"transformation": {
				"fields": ["ico", "country", "name", "directors", "partners"]
			},
			"display": {
				"component": "table",
				"properties": {
					"ico": { "label": "IČO", "format": "text" },
					"name": { "label": "Name", "format": "text" },
					"country": { "label": "Country", "format": "text" },
					"directors": { "label": "Statutory body", "format": "array" },
					"partners": { "label": "Shareholders", "format": "array" }
				}
			}
		},
		"redFlags": {
			"title": "Red flags",
			"description": "Risk signals — insolvency, debts, temporary protection, inactive VAT, dissolution date.",
			"transformation": {
				"fields": [
					"ico",
					"country",
					"name",
					"warnings",
					"vatStatus",
					"registrace",
					"dissolvedAt",
					"dataFreshness"
				],
				"flatten": ["warnings", "vatStatus", "registrace", "dataFreshness"]
			},
			"display": {
				"component": "table",
				"properties": {
					"ico": { "label": "IČO", "format": "text" },
					"name": { "label": "Name", "format": "text" },
					"country": { "label": "Country", "format": "text" },
					"warnings.hasInsolvency": {
						"label": "Insolvency",
						"format": "boolean"
					},
					"warnings.hasDebts": { "label": "Debts", "format": "boolean" },
					"warnings.hasTemporaryProtection": {
						"label": "Temporary protection",
						"format": "boolean"
					},
					"vatStatus.active": { "label": "VAT payer", "format": "boolean" },
					"registrace.ir": {
						"label": "Insolvency registry",
						"format": "text"
					},
					"dissolvedAt": { "label": "Dissolved", "format": "date" },
					"dataFreshness.aresUpdatedAt": {
						"label": "CZ updated",
						"format": "date"
					}
				}
			}
		}
	}
}
